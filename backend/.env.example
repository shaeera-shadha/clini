# live = call Groq; mock = replay recorded fixtures (works offline, no key needed)
LLM_MODE=mock
# Get a free key at https://console.groq.com/keys (never commit .env)
GROQ_API_KEY=
# Must be two DIFFERENT models so verification is independent of extraction
EXTRACTOR_MODEL=openai/gpt-oss-120b
VERIFIER_MODEL=qwen/qwen3.8-27b
# In-flight LLM requests (free tier: keep at 2 or less)
MAX_CONCURRENCY=2
# Retries on rate limits / transient errors (exponential backoff)
MAX_RETRIES=5
# Artificial delay per mock call so the pipeline stepper is visible in demos
MOCK_LATENCY_MS=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
